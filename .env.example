# Copy this file to .env and fill in every CHANGE_ME / blank value below
# before `docker compose up`. The compose file reads every variable below.
#
# Variables marked REQUIRED will cause `docker compose up` to abort immediately
# if left blank — this prevents services from starting with insecure defaults.

# ── REQUIRED ────────────────────────────────────────────────────────
# JWT signing secret. Must be ≥ 32 bytes of entropy.
#   openssl rand -base64 48
JWT_SECRET=

# Blind-index HMAC secret for searchable encrypted fields. Must be ≥ 32 bytes.
#   openssl rand -base64 48
# ⚠ Stability: this secret is used to derive blind indexes for email search and
# login lookups. If you change it after the first `docker compose up`, existing
# users will not be findable and login will fail until data is wiped and reseeded.
# Choose a value before first boot and keep it stable for the lifetime of the volume.
BLIND_INDEX_SECRET=

# ── Postgres ────────────────────────────────────────────────────────
# Replace CHANGE_ME with a strong password BEFORE first `docker compose up`.
# It's baked into the postgres data dir on initialisation and cannot be
# changed afterwards without `docker compose down -v` (which wipes the DB).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Keycloak ────────────────────────────────────────────────────────
# Replace CHANGE_ME with a strong password BEFORE first `docker compose up`
# — same caveat as Postgres above, the admin user is created on first boot.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── Host ports (change these if 8080/8081/8090 clash with something) ─
# Services bind to 127.0.0.1 by default — only accessible from this machine.
WEB_HTTP_PORT=8081
API_HTTP_PORT=8080
KEYCLOAK_HTTP_PORT=8090

# ── LAN access ──────────────────────────────────────────────────────
# To reach the stack from other machines on your network:
#   1. Set BIND_ADDRESS=0.0.0.0 (web + api listen on all interfaces).
#   2. Point the Public URLs below at this machine's LAN IP, e.g.
#      WEB_PUBLIC_BASE_URL=http://192.168.1.50:8081 — required for CORS and
#      the /setup wizard's origin check; keep each a single origin.
#      (localhost/127.0.0.1 stay usable from the host itself — docker-compose.yml
#      appends the loopback origins to the CORS allowlist.)
#   3. Re-apply: docker compose up -d
#   4. If the host runs a firewall (Ubuntu ufw), allow the app ports:
#        sudo ufw allow 8081/tcp   # web
#        sudo ufw allow 8080/tcp   # api (the browser calls it directly)
#      IMPORTANT: this is defence-in-depth for non-Docker services and clarity —
#      Docker publishes ports via its own iptables rules which BYPASS ufw, so
#      BIND_ADDRESS (not ufw) is what actually controls this stack's exposure.
# Caveats:
#   - Traffic is plain HTTP (unencrypted) — fine for LAN evaluation; put a
#     TLS-terminating reverse proxy in front for anything more (see
#     docs/docker-production-setup.html), then set REQUIRE_HTTPS=true and
#     TRUSTED_PROXY_CIDR (see the REQUIRE_HTTPS block below).
#   - PWA/offline features need https:// or http://localhost, so they stay
#     inactive when browsing via a LAN IP.
#   - The Keycloak admin console stays loopback-only regardless of BIND_ADDRESS.
#     Set KEYCLOAK_BIND_ADDRESS=0.0.0.0 (and ufw allow 8090/tcp) only if you
#     need Entra SSO browser redirects or remote console access.
#   - If this install previously ran with demo seeding, the demo accounts
#     (admin@tms.local / Admin@1234) still exist in the database — change or
#     remove them BEFORE exposing the stack beyond this machine.
#BIND_ADDRESS=127.0.0.1
#KEYCLOAK_BIND_ADDRESS=127.0.0.1

# ── Public URLs ─────────────────────────────────────────────────────
# What the user's browser hits. If you change the host ports above — or expose
# the stack on the LAN via BIND_ADDRESS — mirror the host/ports here. The API
# uses WEB_PUBLIC_BASE_URL for CORS and the /setup origin check, it doubles as
# the SSO redirect base, and KEYCLOAK_PUBLIC_BASE_URL is rendered into
# per-tenant SSO setup instructions (all three are required by API fail-fast
# guards whenever the environment isn't Development).
# Behind a reverse proxy: set all three to their public HTTPS origins.
WEB_PUBLIC_BASE_URL=http://localhost:8081
API_PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8090

# ── Environment ─────────────────────────────────────────────────────
# Production (the default) seeds reference data (roles, permissions, lookups)
# and sends you through the first-run /setup wizard to create your own admin
# account. Development additionally relaxes fail-fast guards and logs
# human-readable console output.
ASPNETCORE_ENVIRONMENT=Production

# Demo tenants + demo logins (admin@tms.local / Admin@1234) — handy for a quick
# evaluation, weak for anything reachable by others. Off unless set to true here
# (this variable is the single switch on this stack, in every environment mode).
# Value must be exactly true or false (1/yes/on are not accepted).
#DEMO_SEEDER_ENABLED=false

# HTTPS-only posture (Secure cookies), exactly true or false (1/yes/on are not
# accepted). This stack is plain HTTP end-to-end, so the default here is false —
# the /setup wizard could not issue its antiforgery token otherwise. Set to true
# once a TLS-terminating reverse proxy fronts the stack (it must send
# X-Forwarded-Proto: https).
#REQUIRE_HTTPS=false

# CIDR whose X-Forwarded-* headers the app trusts (default: loopback only). Set
# this to where the reverse proxy's traffic ENTERS the app container, which is
# NOT the proxy's public address:
#   - proxy as another service in this compose network → the Docker network CIDR
#     the proxy shares with the app (e.g. 172.16.0.0/12 covers Docker's default
#     bridge pools; tighten to the network's subnet if you pin one).
#   - proxy on the host hitting 127.0.0.1:<port> → leave the loopback default.
# Getting this wrong with REQUIRE_HTTPS=true makes /setup 500 (the app never sees
# the request as HTTPS), so verify with `docker compose logs apiservice`.
#TRUSTED_PROXY_CIDR=127.0.0.1/32

# Two-letter prefix for ticket numbers (e.g. SS-1, SS-2, …).
TICKET_NUMBER_PREFIX=SS

# ── Optional: Bitwarden Secrets Manager ─────────────────────────────
# When both are set, the API's BitwardenSecretsManager configuration provider
# overrides the JWT/Encryption secrets above with values from Bitwarden.
# Leave blank to use the local values above (the default for local evaluation).
BWS_ACCESS_TOKEN=
BWS_ORGANIZATION_ID=

# ── External Postgres (optional) ────────────────────────────────────
# Set PG_HOST to use an existing Postgres instance instead of the bundled
# container. Both ticketdb and keycloakdb must already exist on that server
# (see scripts/postgres-init/01-create-databases.sh).
# POSTGRES_USER and POSTGRES_PASSWORD (above) are used as the connection
# credentials — update them to match your external instance.
# install.sh auto-activates docker-compose.external-pg.yml when PG_HOST is set.
#PG_HOST=
#PG_PORT=5432

# ── Optional: GitHub Secrets Manager (alt. to Bitwarden) ─────────────
# When both GH_SECRETS_TOKEN and GH_SECRETS_REPO are set, the API loads
# secret NAMES from the GitHub REST API and resolves each VALUE from a
# matching env var (GitHub Actions / Codespaces inject these from secrets).
# Convention: `__` in a secret name maps to `:` in configuration
# (e.g. JWT__SECRET → Jwt:Secret), matching .NET's standard convention.
# If both Bitwarden and GitHub are configured, GitHub wins (loaded last).
GH_SECRETS_TOKEN=
GH_SECRETS_REPO=
# Optional: scope to a GitHub Environment (e.g. production, staging)
GH_SECRETS_ENVIRONMENT=
# Optional: prefix to look up env vars by — useful in Codespaces where you
# may want to namespace TMS secrets (e.g. TMS_JWT__SECRET).
GH_SECRETS_PREFIX=
