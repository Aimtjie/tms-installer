# Single-domain overlay settings (#1182). These are ADDED to the root .env — copy
# the root .env.example first and fill in its secrets (JWT_SECRET, BLIND_INDEX_SECRET,
# POSTGRES_PASSWORD, KEYCLOAK_ADMIN_PASSWORD, …), then append the variables below.
#
# See onprem/compose/README.md for the full walkthrough.

# ── The single public origin ────────────────────────────────────────────────────
# The full URL the browser uses. Everything (web, API, SignalR, sign-in) is served
# from here. Include the scheme, no trailing slash.
TMS_PUBLIC_URL=https://tms.server.domain

# Just the hostname (no scheme) — used by the Caddy / Traefik proxies. Must match
# the certificate and TMS_PUBLIC_URL.
TMS_HOSTNAME=tms.server.domain

# ── TLS (operator-supplied certificate) ─────────────────────────────────────────
# Absolute paths on the host to the certificate (with intermediates) and its key.
# The proxy mounts these read-only. To test before your real certificate arrives,
# see "Generating a certificate for testing" in the README.
TLS_CERT_FILE=/etc/tms/tls/fullchain.pem
TLS_KEY_FILE=/etc/tms/tls/privkey.pem

# ── Proxy published ports ────────────────────────────────────────────────────────
# The proxy is the ONLY service exposed externally. 80 redirects to 443.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ── Forwarded-header trust ───────────────────────────────────────────────────────
# The proxy reaches the app containers from the Docker network (not loopback), so the
# app must trust that range to honour X-Forwarded-Proto=https (Secure cookies + HSTS)
# and to rate-limit by the real client IP. Docker's default address pools fall in
# 172.16.0.0/12; narrow this to your stack's actual network CIDR to tighten.
# Find it with: docker network inspect tms_default -f '{{(index .IPAM.Config 0).Subnet}}'
#
# NOTE: the root .env.example also defines TRUSTED_PROXY_CIDR (default 127.0.0.1/32).
# Appended after it, THIS line wins — Compose is last-wins — which is what single-domain
# needs (the proxy is a container, not loopback). Edit the value HERE, not the root copy,
# or your change is silently overridden.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# ── App ports are not published ──────────────────────────────────────────────────
# The single-domain overlay un-publishes the app + Keycloak host ports (ports: !reset
# []), so they are reachable only by the proxy over the internal Docker network.
# BIND_ADDRESS has no effect here — the proxy on 80/443 is the single ingress.

# ── SSO (Microsoft Entra / OIDC) — optional ──────────────────────────────────────
# SSO is served at https://tms.server.domain/auth. Set the tms-sso client secret below
# to enable it; leave it blank to keep SSO disabled (ssoEnabled=false). When set, the
# API registers the callback https://tms.server.domain/api/auth/sso/callback on the
# tms-sso Keycloak client automatically at startup (from Sso__WebRedirectBaseUrl) — no
# manual realm edit. Configure the Entra identity provider per tenant from the TMS app
# UI (Client detail → SSO).
SSO_CLIENT_SECRET=
