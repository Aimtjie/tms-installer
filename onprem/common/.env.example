# TMS self-hosted configuration
#
# Copy this file to `.env` alongside it, then fill in the REQUIRED values.
# `./tmsctl install` can generate the secrets for you and write them here.
#
# One file drives every target (k3s, k8s, compose, swarm). Settings that only
# apply to some targets say so. `CONFIG.md` in this folder documents each key
# in more detail, including how it maps to the application's own settings.
#
# Keep this file readable only by root:  chmod 600 .env


# ══ TARGET ══════════════════════════════════════════════════════════
# Which deployment you are running. `./tmsctl install` sets this for you.
#   k3s     — we install Kubernetes on your servers (1 for demo, 3 for HA)
#   k8s     — you already have a Kubernetes cluster
#   compose — single server, Docker Compose
#   swarm   — single server, Docker Swarm
TMS_TARGET=k3s


# ══ secrets — leave blank and the installer generates them ══════════
# You can leave both of these empty: the installer mints a strong value for each
# and writes them into an encrypted escrow bundle for you to store off the machine.
# Fill one in only to supply your OWN value — most importantly when RESTORING a
# backup, where BLIND_INDEX_SECRET below MUST match the original. Generate with:
#   openssl rand -base64 48

# Signs the tokens users log in with. Changing it later logs everyone out,
# which is inconvenient but safe. Leave blank to auto-generate.
JWT_SECRET=

# ⚠ CANNOT BE CHANGED AFTER FIRST INSTALL — READ THIS ONE.
# Derives the searchable index for encrypted fields such as email addresses.
# If this value changes, existing users become unfindable and login stops
# working. There is no migration and no recovery other than restoring a backup
# taken with the original value.
# Leave blank on a NEW install to auto-generate (it is escrowed for you). On a
# RESTORE, paste the ORIGINAL value here — a fresh one makes the restored data
# permanently unreadable. Once set, back it up and never rotate it.
BLIND_INDEX_SECRET=


# ══ REQUIRED — how people reach TMS ═════════════════════════════════
# TMS is served from a SINGLE hostname. The web app, the API and the login
# service all live under it on different paths, which means one DNS record and
# one certificate. Do not add a second hostname for the login service.
#
#   https://tickets.example.internal/          → web app
#   https://tickets.example.internal/api/      → API
#   https://tickets.example.internal/auth/     → login (Keycloak)
#
# Point a DNS A record for this name at the server (single-node) or at the
# virtual IP (3-server HA — see TMS_VIP below).
TMS_HOSTNAME=tickets.example.internal

# Your TLS certificate and its private key, as PEM files readable by root.
# The certificate must cover TMS_HOSTNAME exactly (a wildcard is fine).
# Include the full chain — intermediates as well as the leaf — or some browsers
# and mobile clients will reject it even though your desktop browser accepts it.
#
# ⚠ Nothing renews this for you. `./tmsctl status` warns 30 days out and errors
# at 7. Put the expiry date in a calendar today. `./tmsctl cert replace` swaps it.
TLS_CERT_FILE=/etc/tms/tls/fullchain.pem
TLS_KEY_FILE=/etc/tms/tls/privkey.pem


# ══ REQUIRED — off-box backups ══════════════════════════════════════
# `./tmsctl install` will not finish without these. A self-hosted system with
# no backups is not a system anyone should hand over.
#
# Backups go to a restic repository. Any of these work:
#   sftp:backupuser@backup.example.internal:/srv/tms-backups
#   /mnt/backup-share/tms          (an NFS or SMB mount)
#   s3:https://s3.example.internal/tms-backups
#
# ⚠ "Off-box" is the point. A path on the TMS server itself is not a backup —
# it dies with the machine it is protecting.
BACKUP_REPOSITORY=

# Encrypts the backup. Generate with:  openssl rand -base64 48
# ⚠ Lose this and the backups are unreadable. Store it with the other secrets.
BACKUP_PASSWORD=

# Credentials for the backup location, if it needs them. Leave blank for a
# filesystem mount. See CONFIG.md for the variables each backend expects.
#BACKUP_ENV_EXTRA=

# When the nightly backup runs, in UTC, as a cron expression.
BACKUP_SCHEDULE=0 2 * * *

# How many to keep.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6


# ══ Attachments ═════════════════════════════════════════════════════
# Where uploaded files are stored. ⚠ Changing this later requires a migration
# (`./tmsctl storage migrate`) — it is not just a setting.
#
#   local    — a volume on the server. The only value the k3s target implements
#              today, and the default. Attachments ARE included in the nightly
#              backup: the backup job mounts that volume and pushes it to your
#              off-box repository along with the database.
#              On a 3-server install it must become storage every server can
#              reach — a single-server volume will NOT work. See k3s/README.md.
#
#   s3       — NOT WIRED UP YET on the k3s target. The value is read but never
#              applied, so it is REJECTED at install rather than accepted.
#
#   postgres — NOT AVAILABLE YET. Stores files inside the database, so files
#              inherit the database's automatic failover. Landing separately.
#
# Anything not listed above is rejected, and so is anything listed here as not
# implemented. That is deliberate: the application treats any unrecognised value
# as `local`, so a value accepted here but not wired up would put your files
# somewhere you did not choose — and you would find out at a restore.
STORAGE_PROVIDER=local

# ⚠ NOT USED by the k3s target. There the path is fixed at /var/tms/attachments
# inside the container, backed by a Kubernetes volume, and setting this has no
# effect. It applies to the compose and swarm targets.
#STORAGE_LOCAL_PATH=/var/lib/tms/attachments

# For STORAGE_PROVIDER=s3, once it is wired up. Not read today.
#STORAGE_S3_ENDPOINT=
#STORAGE_S3_BUCKET=tms-attachments
#STORAGE_S3_ACCESS_KEY_ID=
#STORAGE_S3_SECRET_ACCESS_KEY=


# ══ Passwords generated at install ══════════════════════════════════
# `./tmsctl install` fills these in. You should not need to touch them, but they
# belong in your password manager along with everything else above.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
SSO_CLIENT_SECRET=


# ══ Kubernetes ══════════════════════════════════════════════════════
# Namespace to install into. Read by both k3s and k8s.
K8S_NAMESPACE=tms

# StorageClass for the ATTACHMENTS volume. Not the database — PostgreSQL replicates
# onto each server's own disk and stays on local-path whatever you set here.
#   k3s — leave as local-path for a single server. For 3-server HA (Stage B) point
#         it at storage every server can reach (NFS/SMB), BEFORE you install:
#         a volume's storage class cannot be changed once it has been created.
#   k8s — NOT read from here; set storage.className in the chart's values.
K8S_STORAGE_CLASS=local-path

# How that volume may be mounted. Leave this alone unless your shared storage made you
# change it: ReadWriteOnce means one server at a time, NOT one server for ever, so the
# API still moves after a failure. Set ReadWriteMany only if the storage your admin
# prepared is offered as ReadWriteMany — a volume offered ONLY that way will never be
# accepted by a ReadWriteOnce request, and the install stops with the volume unbound.
# Also fixed when the volume is created.
K8S_STORAGE_ACCESS_MODE=ReadWriteOnce

# ── k8s target only, and all optional ───────────────────────────────
# On the k8s target this file configures almost nothing — the chart's values.yaml
# does. These three only affect what `tmsctl` can tell you about an installation
# it did not create, so leaving them blank costs you clarity, never correctness.
#
# The name of your TLS Secret, if it is not the default. `tmsctl status` reads it
# to warn you before the certificate expires; nothing renews it for you.
#K8S_TLS_SECRET=tms-tls
#
# Where your ingress controller runs. We do not install it and cannot guess the
# namespace, so `tmsctl logs ingress` asks for it rather than guessing wrong and
# printing an empty result.
#K8S_INGRESS_NAMESPACE=ingress-nginx
#
# Your database host, purely so `tmsctl status` can name it when it reports that
# the database is yours rather than ours.
#POSTGRES_HOST=

# ── 3-server HA only; leave blank for a single server ───────────────
# A spare IP address that moves between your servers so there is always one
# address that works. It must be UNUSED and on the SAME network segment as all
# three servers — if they are on different subnets, ARP takeover cannot work
# and you should read the fallback in k3s/README.md instead.
#TMS_VIP=

# How many copies of each component to run. Defaults suit 8 GB servers; on
# 4 GB servers use KEYCLOAK=1 and API/WEB=2.
#REPLICAS_API=3
#REPLICAS_WEB=3
#REPLICAS_KEYCLOAK=2

# Database copies. 1 for a single server; 3 for HA.
# ⚠ Never set this to 2. With two copies and synchronous replication, losing one
# server leaves nobody to confirm writes and the database stops accepting them —
# the opposite of what you wanted. Use 1 or 3.
#POSTGRES_INSTANCES=1


# ══ Single-server targets (compose and swarm) ═══════════════════════
# Ports published on the host. Only reachable from this machine unless you
# change BIND_ADDRESS.
#WEB_HTTP_PORT=8081
#API_HTTP_PORT=8080

# 127.0.0.1 = this machine only. 0.0.0.0 = anyone who can reach this machine.
# Note that Docker publishes ports through its own firewall rules, which BYPASS
# ufw — so this setting, not ufw, is what actually controls exposure.
#BIND_ADDRESS=127.0.0.1


# ══ Optional ════════════════════════════════════════════════════════
# Prefix for ticket numbers, e.g. SS-1, SS-2.
TICKET_NUMBER_PREFIX=SS

# Default data-residency region when a client has no explicit setting.
# One of: EU, UK, US, APAC, ZA
REGIONS_DEFAULT=ZA

# Demo tenants and a demo login. Leave off for anything real — on first start
# you will be sent to a /setup page to create your own administrator instead.
# Must be exactly true or false.
#DEMO_SEEDER_ENABLED=false

# Email is NOT configured here. TMS reads its mail settings from the database so
# they can be changed without a redeploy — set them in Administration → Notifications
# after you first log in. Until then, TMS will not send email.
