{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMS chart values",
  "description": "Machine-checkable constraints. The explanations for the constraints that need one live in templates/_validate.tpl, which runs after this and produces the message an operator can act on.",
  "type": "object",
  "required": ["hostname", "tls", "ingress", "storage", "postgres", "network", "secrets", "api", "web", "keycloak", "attachments", "images"],
  "properties": {
    "hostname": {
      "type": "string",
      "description": "Bare DNS name, no scheme and no path.",
      "pattern": "^$|^[a-zA-Z0-9]([-a-zA-Z0-9]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([-a-zA-Z0-9]*[a-zA-Z0-9])?)*$"
    },
    "tls": {
      "type": "object",
      "required": ["secretName"],
      "properties": {
        "secretName": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["className", "controller"],
      "properties": {
        "className": { "type": "string" },
        "controller": { "type": "string", "enum": ["nginx", "none"] }
      }
    },
    "storage": {
      "type": "object",
      "required": ["className", "size"],
      "properties": {
        "className": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["host", "port", "username", "database", "keycloakDatabase", "sslMode"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "keycloakDatabase": { "type": "string", "minLength": 1 },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "require", "verify-ca", "verify-full"],
          "description": "These are four different security postures, not spellings of one another. Since Npgsql 8, 'require' encrypts without verifying the server's identity."
        },
        "caSecretName": { "type": "string" },
        "caSecretKey": { "type": "string" },
        "trustSystemCaStore": { "type": "boolean" },
        "keycloak": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["trustedProxyCidrs"],
      "properties": {
        "trustedProxyCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
          }
        },
        "trustProxyRfc1918": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "api": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Must be 1. NOT constrained here on purpose: schema validation runs before template rendering and short-circuits it, so a `const` would replace _validate.tpl's explanation with 'value must be 1' — and an operator who reads that concludes we were being cautious and routes around it. The refusal lives in _validate.tpl, which runs on template, lint, dry-run and install alike."
        }
      }
    },
    "web": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "keycloak": {
      "type": "object",
      "required": ["relativePath"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^/[a-zA-Z0-9][a-zA-Z0-9/_-]*$", "description": "At least one path segment. Keycloak and the web app cannot both own the root of the shared hostname." },
        "realm": {
          "type": "object",
          "properties": {
            "existingConfigMap": { "type": "string" }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "attachments": {
      "type": "object",
      "required": ["provider", "path"],
      "properties": {
        "provider": {
          "type": "string",
          "description": "Must be \"local\". Refused in _validate.tpl rather than here, for the same reason as api.replicas: the explanation matters more than the check, and a schema `const` would hide it."
        },
        "path": { "type": "string", "pattern": "^/.*" }
      }
    },
    "images": {
      "type": "object",
      "required": ["api", "web", "keycloak", "redis", "pullPolicy"],
      "properties": {
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      },
      "additionalProperties": true
    },
    "migrations": {
      "type": "object",
      "properties": { "autoReconcileSquash": { "type": "boolean" } }
    },
    "preflight": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "apiScaleGuard": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "tickets": {
      "type": "object",
      "properties": { "numberPrefix": { "type": "string", "minLength": 1, "maxLength": 8 } }
    },
    "regions": {
      "type": "object",
      "properties": { "default": { "type": "string", "minLength": 2 } }
    }
  }
}
